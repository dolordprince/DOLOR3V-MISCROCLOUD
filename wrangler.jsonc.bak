{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dolor3v-microcloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MicrocloudAgentDO",
        "class_name": "MicrocloudAgentDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "MicrocloudAgentDO"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}
